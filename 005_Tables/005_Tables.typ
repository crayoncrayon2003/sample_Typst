// 表のサンプル
#set text(lang: "ja", font: ("Noto Serif CJK JP",))
#set page(numbering: "1")

#align(center)[
  #text(size: 1.6em)[*表のサンプル*] \
  Typst サンプル
]

// -------------------------------------------------------------------
// 基本的な表
// -------------------------------------------------------------------
= 基本的な表

#table(
  columns: 3,
  align: (left, center, right),  // 列ごとの揃え
  [左寄せ], [中央], [右寄せ],
  [Apple], [100], [円],
  [Banana], [80], [円],
  [Cherry], [200], [円],
)

// -------------------------------------------------------------------
// 罫線を減らした洗練されたスタイル（booktabs 風）
// -------------------------------------------------------------------
= booktabs 風スタイル

#figure(
  caption: [果物の価格一覧],
  table(
    columns: 3,
    align: (left, right, right),
    stroke: none,                       // 既定の枠線を消す
    // 上罫線・見出し下罫線・下罫線だけを引く
    table.hline(stroke: 1pt),
    table.header([名前], [単価（円）], [在庫数]),
    table.hline(stroke: 0.5pt),
    [Apple], [100], [50],
    [Banana], [80], [30],
    [Cherry], [200], [20],
    table.hline(stroke: 0.5pt),
    [合計], [---], [100],
    table.hline(stroke: 1pt),
  ),
) <tab:fruits>

// -------------------------------------------------------------------
// 列の結合（colspan）
// -------------------------------------------------------------------
= 列の結合 (colspan)

#table(
  columns: 3,
  align: center,
  table.cell(colspan: 3)[3列をまとめたヘッダー],
  [列A], [列B], [列C],
  [1], [2], [3],
  [4], [5], [6],
)

// -------------------------------------------------------------------
// 行の結合（rowspan）
// -------------------------------------------------------------------
= 行の結合 (rowspan)

#table(
  columns: 3,
  align: center,
  table.cell(rowspan: 2)[結合セル], [A1], [B1],
  [A2], [B2],
)

// -------------------------------------------------------------------
// セルの色付け（fill）
// -------------------------------------------------------------------
= セルの色付け

#table(
  columns: 3,
  align: (left, center, center),
  // 行全体に色を付ける（table.cell の fill）
  table.cell(fill: luma(220))[名前],
  table.cell(fill: luma(220))[数値1],
  table.cell(fill: luma(220))[数値2],
  [行1], table.cell(fill: yellow.lighten(40%))[10], [20],
  [行2], [30], table.cell(fill: aqua.lighten(40%))[40],
  [行3], [50], [60],
)

// 列・行のしましま（fill 関数）も指定できます:
// #table(columns: 3, fill: (_, row) => if calc.odd(row) { luma(240) }, ...)

// -------------------------------------------------------------------
// 列幅の固定
// -------------------------------------------------------------------
= 列幅の固定

#table(
  columns: (auto, 6cm),   // 1列目は内容に合わせ、2列目は 6cm 固定
  align: (left, left),
  [項目], [説明],
  [Typst], [モダンな文書組版システム。高品質な数式や図表を含む文書を作成できます。],
  [Hayagriva], [参考文献の管理ツール。.yml または .bib ファイルで文献情報を管理します。],
)
