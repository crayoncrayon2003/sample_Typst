// スクリプティングのサンプル（Typst 独自）
// Typst は本格的なスクリプト言語を内蔵しており、変数・関数・条件分岐・
// ループ・配列・辞書などを文書内で直接使えます。
#set text(lang: "ja", font: ("Noto Serif CJK JP",))
#set page(numbering: "1")
#set heading(numbering: "1.1")

#align(center)[
  #text(size: 1.8em)[*スクリプティングのサンプル*] \
  Typst サンプル
]

// -------------------------------------------------------------------
// 変数とコードモード
// -------------------------------------------------------------------
= 変数とコードモード

`#` を付けるとコードモードに入ります。`#let` で変数を定義します。

#let name = "Typst"
#let year = 2019
#let pi-approx = 3.14159

- 名前: #name
- 誕生年: #year
- 円周率の近似: #pi-approx

計算もできます: $1 + 2 + dots.c + 100 =$ #{
  let total = 0
  for i in range(1, 101) { total += i }
  total
}

// -------------------------------------------------------------------
// 条件分岐
// -------------------------------------------------------------------
= 条件分岐

#let score = 75

判定: #if score >= 80 [優] else if score >= 60 [良] else [可]

// -------------------------------------------------------------------
// ループ
// -------------------------------------------------------------------
= ループ

`for` ループでコンテンツを繰り返し生成できます。

#for i in range(1, 6) [
  項目 #i ・
]

九九の一部（`while` ループ）:

#{
  let i = 1
  while i <= 5 {
    [2 × #i = #(2 * i) #h(1em)]
    i += 1
  }
}

// -------------------------------------------------------------------
// 配列
// -------------------------------------------------------------------
= 配列

#let fruits = ("Apple", "Banana", "Cherry")

- 要素数: #fruits.len()
- 先頭: #fruits.at(0)
- 結合: #fruits.join("、")

`map` で加工:

#let nums = (1, 2, 3, 4, 5)
2乗のリスト: #nums.map(x => x * x)

合計: #nums.sum()、最大: #nums.fold(0, calc.max)

// -------------------------------------------------------------------
// 辞書
// -------------------------------------------------------------------
= 辞書

#let person = (name: "山田太郎", age: 30, city: "東京")

- 名前: #person.name
- 年齢: #person.age
- 都市: #person.city

// -------------------------------------------------------------------
// データから表を生成
// -------------------------------------------------------------------
= データから表を生成

配列・ループと組み合わせると、データから動的に表を作れます。

#let data = (
  ("Apple", 100, 50),
  ("Banana", 80, 30),
  ("Cherry", 200, 20),
)

#table(
  columns: 3,
  align: (left, right, right),
  table.header([名前], [単価], [在庫]),
  ..data.map(row => row.map(cell => [#cell])).flatten(),
)
