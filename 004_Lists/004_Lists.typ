// リストのサンプル
#set text(lang: "ja", font: ("Noto Serif CJK JP",))
#set page(numbering: "1")

#align(center)[
  #text(size: 1.6em)[*リストのサンプル*] \
  Typst サンプル
]

// -------------------------------------------------------------------
// 箇条書き（unordered list）: 行頭の "-"
// -------------------------------------------------------------------
= 箇条書き

- 項目1
- 項目2
- 項目3

// -------------------------------------------------------------------
// 番号付きリスト（ordered list）: 行頭の "+"
// -------------------------------------------------------------------
= 番号付きリスト

+ 最初の手順
+ 次の手順
+ 最後の手順

// -------------------------------------------------------------------
// 説明リスト（term list）: "/ 用語: 説明"
// -------------------------------------------------------------------
= 説明リスト

/ Typst: モダンな文書組版システム
/ Hayagriva: Typst の参考文献管理ツール
/ CeTZ: Typst 用の図形描画パッケージ

// -------------------------------------------------------------------
// ネストされたリスト（インデントで階層を表現）
// -------------------------------------------------------------------
= ネストされたリスト

- レベル1
  - レベル2
    - レベル3
      - レベル4（最深）

// 番号付きのネスト
+ 第1項
  + 第1-1項
  + 第1-2項
+ 第2項

// -------------------------------------------------------------------
// リストのカスタマイズ（set ルール）
// -------------------------------------------------------------------
= リストのカスタマイズ

// 番号の書式を変更（I. II. III. ...）
#enum(
  numbering: "I.",
  [ローマ数字 I], [ローマ数字 II], [ローマ数字 III],
)

// (a) (b) (c) 形式
#enum(
  numbering: "(a)",
  [アルファベット a], [アルファベット b], [アルファベット c],
)

// 行頭マーカーを変更
#list(
  marker: ([◆], [▶], [•]),
  [マーカーを変えた項目1],
  [マーカーを変えた項目2],
)

// 開始番号を途中から指定
#enum(
  start: 5,
  [5番目から開始], [6番目], [7番目],
)

// 間隔を詰める（tight: true。"-" 直書きでも空行を入れなければ tight）
#list(
  tight: true,
  [間隔なし項目1], [間隔なし項目2], [間隔なし項目3],
)
