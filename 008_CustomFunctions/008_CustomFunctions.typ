// カスタム関数・変数のサンプル
// （LaTeX の \newcommand / \newenvironment に相当する内容を Typst の #let で表現します）
#set text(lang: "ja", font: ("Noto Serif CJK JP",))
#set page(numbering: "1")

// -------------------------------------------------------------------
// #let: 変数（引数なしのマクロに相当）
// -------------------------------------------------------------------
#let myname = "Typst サンプルユーザー"
#let RR = math.bb("R")   // 実数集合 ℝ
#let NN = math.bb("N")   // 自然数集合 ℕ

// -------------------------------------------------------------------
// #let: 引数つき関数
// -------------------------------------------------------------------
// 1引数: 赤い太字で強調
#let highlight-text(body) = text(fill: red, weight: "bold", body)

// 2引数: 分数
#let myfrac(num, den) = $(#num) / (#den)$

// デフォルト引数つき（名前付き引数 color に既定値 blue）
#let colortext(body, color: blue) = text(fill: color, body)

// -------------------------------------------------------------------
// 独自の「環境」（枠付きボックスを返す関数）
// -------------------------------------------------------------------
#let mybox(body) = align(center,
  block(
    width: 85%,
    stroke: 0.5pt,
    inset: 10pt,
    radius: 3pt,
    body,
  )
)

#align(center)[
  #text(size: 1.6em)[*カスタム関数のサンプル*] \
  #myname
]

// -------------------------------------------------------------------
// 引数なし（変数）
// -------------------------------------------------------------------
= 引数なし（変数）

著者は `#myname` → #myname

実数集合 $RR$、自然数集合 $NN$（`#RR`, `#NN`）

// -------------------------------------------------------------------
// 1引数関数
// -------------------------------------------------------------------
= 1引数関数

`#highlight-text[テキスト]` → #highlight-text[重要な箇所]

// -------------------------------------------------------------------
// 2引数関数
// -------------------------------------------------------------------
= 2引数関数

`#myfrac(a+b, c-d)` → #myfrac($a+b$, $c-d$)

// -------------------------------------------------------------------
// デフォルト引数つき関数
// -------------------------------------------------------------------
= デフォルト引数つき関数

引数省略（既定 blue）: #colortext[青いテキスト]

色を指定: #colortext(color: red)[赤いテキスト]

色を指定: #colortext(color: purple)[紫のテキスト]

// -------------------------------------------------------------------
// 独自「環境」
// -------------------------------------------------------------------
= 独自の枠付きボックス

#mybox[
  これは `mybox` 関数で囲まれたテキストです。
  枠線付きの中央揃えボックスとして表示されます。
]

// -------------------------------------------------------------------
// show ルールで既存要素を上書き（\renewcommand に相当）
// -------------------------------------------------------------------
= show ルールによる上書き

`#show` ルールを使うと、特定の要素の見た目を一括で変更できます。
例えば次の行以降、すべての `raw`（インラインコード）が青くなります:

#show raw: it => text(fill: blue, it)

`コードは青くなる` ようになりました。
