// スライド（プレゼンテーション）のサンプル
// LaTeX の Beamer に相当。Typst では polylux パッケージを使います。
// polylux 0.4.x は「テーマ」を持たない最小構成で、ページ体裁は自分で設定します。
// 初回コンパイル時にネットワークが必要です。
#import "@preview/polylux:0.4.0": *

// スライド全体の体裁（16:9・日本語フォント・大きめの文字）
#set page(paper: "presentation-16-9", margin: 2em)
#set text(lang: "ja", font: ("Noto Sans CJK JP",), size: 25pt)

// 強調ブロックを作るヘルパ（Beamer の block / alertblock 相当）
#let block-box(fill, title, body) = block(
  fill: fill, inset: 10pt, radius: 4pt, width: 100%,
  [*#title* #h(0.3em) #body],
)

// -------------------------------------------------------------------
// タイトルスライド
// -------------------------------------------------------------------
#slide[
  #set align(center + horizon)
  #text(size: 1.8em)[*Typst プレゼンテーション*]

  Typst によるスライド作成サンプル

  #v(1em)
  Typst サンプル / サンプル研究室

  #datetime.today().display("[year]年[month]月[day]日")
]

// -------------------------------------------------------------------
// セクション 1
// -------------------------------------------------------------------
#slide[
  == polylux とは
  - Typst でプレゼンテーションスライドを作成するパッケージ
  - PDF 形式で出力されるため、どの環境でも同じ表示
  - 数式・図・表をそのまま使用可能
]

#slide[
  == スライドの構造
  各スライドは `#slide[...]` で囲みます。

  #block-box(blue.lighten(80%), "ブロック", [重要な情報を囲って強調できます。])
  #v(0.5em)
  #block-box(red.lighten(80%), "アラート", [警告や注意事項に使います。])
  #v(0.5em)
  #block-box(green.lighten(80%), "例示", [例やサンプルに使います。])
]

// -------------------------------------------------------------------
// セクション 2: オーバーレイ（段階表示）
// -------------------------------------------------------------------
#slide[
  == 段階表示（item-by-item）
  polylux 0.4 では `#pause` の代わりに `item-by-item` で項目を順に表示します。

  #item-by-item[
    + 最初に表示
    + 次に表示
    + 最後に表示
  ]
]

#slide[
  == only と uncover
  #only("1")[この行は1枚目だけで表示されます。]
  #only("2-")[この行は2枚目以降で表示されます。]

  #uncover("1-")[- 項目A（常に表示）]
  #uncover("2-")[- 項目B（2枚目以降。場所は確保される）]
  #uncover("3-")[- 項目C（3枚目以降）]
]

// -------------------------------------------------------------------
// セクション 3: 数式
// -------------------------------------------------------------------
#slide[
  == 数式
  インライン数式: $E = m c^2$

  ディスプレイ数式:
  $ integral_(-oo)^(oo) e^(-x^2) dif x = sqrt(pi) $

  $
  (a+b)^2 &= a^2 + 2 a b + b^2 \
  (a-b)^2 &= a^2 - 2 a b + b^2
  $
]

// -------------------------------------------------------------------
// セクション 4: 2カラムレイアウト
// -------------------------------------------------------------------
#slide[
  == 2カラム
  #toolbox.side-by-side[
    *左カラム*
    - 項目1
    - 項目2
    - 項目3
  ][
    *右カラム*
    #align(center)[
      #box(fill: blue.lighten(60%), width: 3cm, height: 2cm, radius: 4pt)
    ]
  ]
]

// -------------------------------------------------------------------
// 最終スライド
// -------------------------------------------------------------------
#slide[
  #set align(center + horizon)
  #text(size: 1.5em)[*ご清聴ありがとうございました*]
]
